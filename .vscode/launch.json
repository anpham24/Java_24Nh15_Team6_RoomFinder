{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run RoomFinder GUI",
            "request": "launch",
            "mainClass": "main",
            "preLaunchTask": "build Java",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/mysql-connector-j-8.3.0.jar"
            ],
            "vmArgs": "-Dfile.encoding=UTF-8"
        },
        {
            "type": "java",
            "name": "Smoke Test",
            "request": "launch",
            "mainClass": "main",
            "args": "--smoke-test",
            "preLaunchTask": "build Java",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/mysql-connector-j-8.3.0.jar"
            ],
            "vmArgs": "-Dfile.encoding=UTF-8"
        },
        {
            "type": "java",
            "name": "Smoke Test With Login",
            "request": "launch",
            "mainClass": "main",
            "args": "--smoke-test",
            "preLaunchTask": "build Java",
            "classPaths": [
                "${workspaceFolder}/build/classes",
                "${workspaceFolder}/lib/mysql-connector-j-8.3.0.jar"
            ],
            "vmArgs": "-Dfile.encoding=UTF-8 -Droomfinder.test.username=your_user -Droomfinder.test.password=your_password"
        }
    ]
}
